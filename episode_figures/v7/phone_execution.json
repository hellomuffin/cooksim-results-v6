  "task_id": "parent_phone_readability",
  "task": "My dad finds his phone hard to read. Make the letters themselves bigger and thicker everywhere, put an outline on buttons so he can tell what he can tap, make colors stand out more sharply from each other, and stop the animations that slide and zoom things around the screen. Only the letters should grow: don't enlarge the icons and buttons, and don't magnify the whole screen.",
  "plan": [
    "tap Accessibility",
    "tap Display & Text Size",
    "tap Larger Text",
    "swipe right on Text Size",
    "press back",
    "tap Bold Text",
    "tap Button Shapes",
    "tap Increase Contrast",
    "press back",
    "tap Motion",
    "tap Reduce Motion"
  ],
